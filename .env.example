# No document access code: anyone with the app URL may view/share and use AI.

# Team archive: server-only administrator key and a PRIVATE dedicated bucket.
SUPABASE_SERVICE_ROLE_KEY=
OVERSEAS_LIBRARY_BUCKET=overseas-guides
